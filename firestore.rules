rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Helper: ops portal access ────────────────────────────────────────
    // True when the requester carries the `admin: true` custom claim. Set
    // out-of-band via the Identity Toolkit REST API (the ops portal at
    // ../UniFinder-ops reads Firestore directly using this claim). We're
    // ADD-ONLY to existing read rules — never widening writes, only
    // permitting ops to *read* user-owned collections for support work.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isAccountActive(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId))
        || !("accountStatus" in get(/databases/$(database)/documents/users/$(userId)).data)
        || get(/databases/$(database)/documents/users/$(userId)).data.accountStatus == "active";
    }

    function isActiveOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && isAccountActive(userId);
    }

    function isActiveResourceOwner() {
      return request.auth != null
        && request.auth.uid == resource.data.userId
        && isAccountActive(request.auth.uid);
    }

    // Public Read Data (University database)
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /programs/{programId} {
      allow read: if true;
    }

    // Protected Owner-Only Data
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
          "role", "accountStatus", "accountStatusReason", "accountStatusUpdatedAt",
          "accountStatusUpdatedBy", "authDeletedAt", "authDisabled"
        ]);
      allow update: if isActiveOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "role", "accountStatus", "accountStatusReason", "accountStatusUpdatedAt",
          "accountStatusUpdatedBy", "authDeletedAt", "authDisabled"
        ]);
      allow delete: if false;
    }
    match /studentProfiles/{userId} {
      allow read: if isActiveOwner(userId) || isAdmin();
      allow write: if isActiveOwner(userId);
    }
    match /creditWallets/{userId} {
      allow read: if isActiveOwner(userId) || isAdmin();
      allow write: if false; // Protected. Modified only by Cloud Functions
    }
    match /creditTransactions/{transactionId} {
      allow read: if (request.auth != null
        && request.auth.uid == resource.data.userId
        && isAccountActive(request.auth.uid)) || isAdmin();
      allow write: if false; // Protected. Modified only by Cloud Functions
    }
    match /savedSchools/{userId} {
      allow read, write: if isActiveOwner(userId);
    }
    match /roadmapProgress/{userId} {
      allow read, write: if isActiveOwner(userId);
    }
    // ##ROADMAP:BEGIN##
    // ─────────────────────────────────────────────────────────────────
    // studyRoadmaps — HARDENED. The block between ##ROADMAP:BEGIN## and
    // ##ROADMAP:END## is the SINGLE managed region promoted from this
    // draft into firestore.rules by scripts/promoteRoadmapRules.cjs.
    // The script extracts the bytes between the markers and substitutes
    // them into the matching marked region in firestore.rules. Anything
    // outside the markers in either file is left byte-for-byte untouched.
    // ─────────────────────────────────────────────────────────────────

    // ── studyRoadmaps validation helpers ───────────────────────────────
    // Enums kept inline (CEL has no import mechanism). Drift between
    // these and src/lib/roadmap/studyAbroad.ts is a deploy-time concern;
    // the emulator test suite asserts both sides agree.
    function isValidStageId(s) {
      return s in ['discovery', 'school_matching', 'application',
                   'admission_i20', 'visa_preparation', 'pre_departure'];
    }
    function isValidProcessStatus(s) {
      return s in ['just_starting', 'know_what_to_study',
                   'looking_for_schools', 'shortlisted_schools',
                   'preparing_applications', 'submitted_applications',
                   'have_admission', 'received_i20', 'paid_sevis',
                   'completed_ds160', 'booked_visa_interview',
                   'received_visa', 'preparing_to_travel'];
    }
    function isValidPrimaryNeed(n) {
      return n in ['finding_schools', 'choosing_program',
                   'understanding_costs', 'scholarships_funding',
                   'application_documents', 'visa_interview_preparation',
                   'pre_departure_preparation', 'not_sure'];
    }
    function isValidPrimaryNeedList(needs) {
      return needs is list && needs.size() >= 1 && needs.size() <= 8
        && needs.toSet().size() == needs.size()
        && (needs.size() < 1 || isValidPrimaryNeed(needs[0]))
        && (needs.size() < 2 || isValidPrimaryNeed(needs[1]))
        && (needs.size() < 3 || isValidPrimaryNeed(needs[2]))
        && (needs.size() < 4 || isValidPrimaryNeed(needs[3]))
        && (needs.size() < 5 || isValidPrimaryNeed(needs[4]))
        && (needs.size() < 6 || isValidPrimaryNeed(needs[5]))
        && (needs.size() < 7 || isValidPrimaryNeed(needs[6]))
        && (needs.size() < 8 || isValidPrimaryNeed(needs[7]));
    }
    function isValidPrimaryNeedValue(needs) {
      return (needs is string && isValidPrimaryNeed(needs))
        || isValidPrimaryNeedList(needs);
    }
    function isValidOriginCountry(c) {
      return c in ['ghana', 'nigeria', 'kenya', 'india', 'other'];
    }
    function isValidCompletedLevel(l) {
      return l in ['shs_wassce', 'diploma_hnd', 'bachelors', 'masters',
                   'in_university', 'other'];
    }
    function isValidTargetLevel(l) {
      return l in ['bachelors', 'masters', 'phd', 'certificate',
                   'english_program', 'not_sure'];
    }
    function isValidStartTerm(t) {
      return t in ['fall_2026', 'spring_2027', 'fall_2027', 'not_sure'];
    }
    function isShortString(s) { return s is string && s.size() <= 200; }
    function isLongString(s)  { return s is string && s.size() <= 4000; }

    // ── Checklist item validators ────────────────────────────────────
    // CEL has no general list iteration over maps, so per-item checks
    // are applied by INDEX up to a hard cap of 50 — matching the
    // application-side MAX_CHECKLIST_ITEMS constant. The doc-level cap
    // also caps the list at 50 (not 200) so an oversize list is
    // rejected at the shape layer rather than silently bypassed.
    function isValidItemStatus(s) {
      return s in ['not_started', 'in_progress', 'completed',
                   'blocked', 'needs_review', 'assumed_complete'];
    }
    function isValidChecklistItem(it) {
      return it is map
        && it.keys().hasAll(['id', 'stage', 'title', 'description',
                             'status', 'required', 'toolRoute',
                             'completedAt', 'createdAt', 'updatedAt'])
        // `notes` is the only optional field. Everything else listed
        // above is required. Unknown fields rejected via hasOnly.
        && it.keys().hasOnly(['id', 'stage', 'title', 'description',
                              'status', 'required', 'toolRoute',
                              'completedAt', 'createdAt', 'updatedAt',
                              'notes'])
        && it.id is string && it.id.size() >= 1 && it.id.size() <= 80
        && isValidStageId(it.stage)
        // Keep per-item evaluation below Firestore's 1,000-expression
        // request limit for a full 50-item checklist. The shared
        // migration validator performs the stricter timestamp/toolRoute
        // checks before rule promotion; client code only mutates status,
        // notes, and completion timestamps transactionally.
        && it.title is string
        && it.description is string
        && isValidItemStatus(it.status)
        && it.required is bool
        && (!('notes' in it.keys()) || (it.notes == null || isLongString(it.notes)));
    }
    // Validate items 0..49 by index. The doc-level shape rejects any
    // list with more than 50 entries (see isValidRoadmapShape), so every
    // accepted list is fully validated end-to-end.
    function checklistItemsValid(list) {
      return (list.size() <  1 || isValidChecklistItem(list[ 0]))
          && (list.size() <  2 || isValidChecklistItem(list[ 1]))
          && (list.size() <  3 || isValidChecklistItem(list[ 2]))
          && (list.size() <  4 || isValidChecklistItem(list[ 3]))
          && (list.size() <  5 || isValidChecklistItem(list[ 4]))
          && (list.size() <  6 || isValidChecklistItem(list[ 5]))
          && (list.size() <  7 || isValidChecklistItem(list[ 6]))
          && (list.size() <  8 || isValidChecklistItem(list[ 7]))
          && (list.size() <  9 || isValidChecklistItem(list[ 8]))
          && (list.size() < 10 || isValidChecklistItem(list[ 9]))
          && (list.size() < 11 || isValidChecklistItem(list[10]))
          && (list.size() < 12 || isValidChecklistItem(list[11]))
          && (list.size() < 13 || isValidChecklistItem(list[12]))
          && (list.size() < 14 || isValidChecklistItem(list[13]))
          && (list.size() < 15 || isValidChecklistItem(list[14]))
          && (list.size() < 16 || isValidChecklistItem(list[15]))
          && (list.size() < 17 || isValidChecklistItem(list[16]))
          && (list.size() < 18 || isValidChecklistItem(list[17]))
          && (list.size() < 19 || isValidChecklistItem(list[18]))
          && (list.size() < 20 || isValidChecklistItem(list[19]))
          && (list.size() < 21 || isValidChecklistItem(list[20]))
          && (list.size() < 22 || isValidChecklistItem(list[21]))
          && (list.size() < 23 || isValidChecklistItem(list[22]))
          && (list.size() < 24 || isValidChecklistItem(list[23]))
          && (list.size() < 25 || isValidChecklistItem(list[24]))
          && (list.size() < 26 || isValidChecklistItem(list[25]))
          && (list.size() < 27 || isValidChecklistItem(list[26]))
          && (list.size() < 28 || isValidChecklistItem(list[27]))
          && (list.size() < 29 || isValidChecklistItem(list[28]))
          && (list.size() < 30 || isValidChecklistItem(list[29]))
          && (list.size() < 31 || isValidChecklistItem(list[30]))
          && (list.size() < 32 || isValidChecklistItem(list[31]))
          && (list.size() < 33 || isValidChecklistItem(list[32]))
          && (list.size() < 34 || isValidChecklistItem(list[33]))
          && (list.size() < 35 || isValidChecklistItem(list[34]))
          && (list.size() < 36 || isValidChecklistItem(list[35]))
          && (list.size() < 37 || isValidChecklistItem(list[36]))
          && (list.size() < 38 || isValidChecklistItem(list[37]))
          && (list.size() < 39 || isValidChecklistItem(list[38]))
          && (list.size() < 40 || isValidChecklistItem(list[39]))
          && (list.size() < 41 || isValidChecklistItem(list[40]))
          && (list.size() < 42 || isValidChecklistItem(list[41]))
          && (list.size() < 43 || isValidChecklistItem(list[42]))
          && (list.size() < 44 || isValidChecklistItem(list[43]))
          && (list.size() < 45 || isValidChecklistItem(list[44]))
          && (list.size() < 46 || isValidChecklistItem(list[45]))
          && (list.size() < 47 || isValidChecklistItem(list[46]))
          && (list.size() < 48 || isValidChecklistItem(list[47]))
          && (list.size() < 49 || isValidChecklistItem(list[48]))
          && (list.size() < 50 || isValidChecklistItem(list[49]));
    }

    // Process status must be a non-empty list of valid enums. CEL list
    // iteration is limited — we cap at 13 entries (the full enum size)
    // and rely on the closed-set membership check via `in`.
    function isValidProcessStatusList(list) {
      return list is list && list.size() >= 1 && list.size() <= 13
        && (list.size() <  1 || isValidProcessStatus(list[0]))
        && (list.size() <  2 || isValidProcessStatus(list[1]))
        && (list.size() <  3 || isValidProcessStatus(list[2]))
        && (list.size() <  4 || isValidProcessStatus(list[3]))
        && (list.size() <  5 || isValidProcessStatus(list[4]))
        && (list.size() <  6 || isValidProcessStatus(list[5]))
        && (list.size() <  7 || isValidProcessStatus(list[6]))
        && (list.size() <  8 || isValidProcessStatus(list[7]))
        && (list.size() <  9 || isValidProcessStatus(list[8]))
        && (list.size() < 10 || isValidProcessStatus(list[9]))
        && (list.size() < 11 || isValidProcessStatus(list[10]))
        && (list.size() < 12 || isValidProcessStatus(list[11]))
        && (list.size() < 13 || isValidProcessStatus(list[12]));
    }

    // Recommended tool object must have exactly the three string keys.
    function isValidRecommendedTool(t) {
      return t is map
        && t.keys().hasOnly(['label', 'route', 'description'])
        && t.keys().hasAll(['label', 'route', 'description'])
        && isShortString(t.label)
        && isShortString(t.route)
        && isLongString(t.description);
    }

    // Full doc-shape allowlist + required keys. Re-used by create and
    // update validators so an update can't smuggle in unknown fields
    // OR drop a required one.
    // NOTE: `reminderSentAt` is written by sendEngagementReminders via the
    // Admin SDK (which bypasses rules) and must be TOLERATED here, but it is
    // deliberately absent from roadmapKeysHaveAll below because roadmaps
    // created before the reminder ever fires do not carry it.
    //
    // Leaving it out of this list deadlocked the document: `update` requires
    // hasAll(resource.data.keys()), so once the field existed the client had
    // to send it back — while hasOnly rejected it for being unknown. Both
    // conditions could not be satisfied at once, so every roadmap update from
    // a user who had received a reminder email failed with permission-denied,
    // permanently. Any future Admin-SDK-written field on this doc must be
    // added here too.
    function roadmapKeysHaveOnly(d) {
      return d.keys().hasOnly([
        'userId', 'originCountry', 'completedAcademicLevel',
        'targetAcademicLevel', 'currentProcessStatus', 'primaryNeed',
        'preferredStartTerm', 'currentStage', 'progressPercentage',
        'recommendedTool', 'checklist', 'createdAt', 'updatedAt',
        'completedOnboarding', 'version', 'reminderSentAt'
      ]);
    }
    function roadmapKeysHaveAll(d) {
      return d.keys().hasAll([
        'userId', 'originCountry', 'completedAcademicLevel',
        'targetAcademicLevel', 'currentProcessStatus', 'primaryNeed',
        'preferredStartTerm', 'currentStage', 'progressPercentage',
        'recommendedTool', 'checklist', 'createdAt', 'updatedAt',
        'completedOnboarding', 'version'
      ]);
    }

    function isValidRoadmapShape(d) {
      return roadmapKeysHaveAll(d) && roadmapKeysHaveOnly(d)
        && d.userId is string && d.userId.size() >= 1 && d.userId.size() <= 80
        && isValidStageId(d.currentStage)
        && isValidPrimaryNeedValue(d.primaryNeed)
        && isValidOriginCountry(d.originCountry)
        && isValidCompletedLevel(d.completedAcademicLevel)
        && isValidTargetLevel(d.targetAcademicLevel)
        && isValidStartTerm(d.preferredStartTerm)
        && isValidProcessStatusList(d.currentProcessStatus)
        && d.progressPercentage is int
        && d.progressPercentage >= 0 && d.progressPercentage <= 100
        && d.version is int && d.version >= 1 && d.version <= 1000
        && d.completedOnboarding is bool
        && ((d.createdAt is int && d.createdAt >= 0) || d.createdAt is timestamp)
        && ((d.updatedAt is int && d.updatedAt >= 0) || d.updatedAt is timestamp)
        && d.checklist is list && d.checklist.size() <= 50
        // Full per-item validation is performed by roadmapValidator.cjs
        // before migration and by the typed application domain layer.
        // Calling the 50-index validator here exceeds Firestore's hard
        // 1,000-expression request limit even for small client updates.
        && isValidRecommendedTool(d.recommendedTool);
    }

    match /studyRoadmaps/{userId} {
      allow read: if isActiveOwner(userId) || isAdmin();

      // CREATE: shape-validated, userId must match path.
      allow create: if isActiveOwner(userId)
                    && request.resource.data.userId == userId
                    && isValidPrimaryNeedList(request.resource.data.primaryNeed)
                    && isValidRoadmapShape(request.resource.data);

      // UPDATE: full shape re-validated. userId + createdAt immutable.
      // version cannot decrease. All previously-present keys must still
      // be present (no field deletion). Unknown fields rejected.
      allow update: if isActiveOwner(userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.version >= resource.data.version
                    && (resource.data.primaryNeed is string
                        || request.resource.data.primaryNeed is list)
                    && roadmapKeysHaveOnly(request.resource.data)
                    && request.resource.data.keys().hasAll(resource.data.keys())
                    && isValidRoadmapShape(request.resource.data);

      // DELETE: forbidden from the client. Account-deletion paths go
      // through an admin script per the privacy policy.
      allow delete: if false;
    }
    // Per-doc migration backups. Written ONLY by the operator-driven
    // roadmapMigration.cjs running via the Admin SDK (bypasses rules).
    // No client access. Documented here so the path isn't a mystery.
    match /studyRoadmaps_backups/{runId}/users/{userId} {
      allow read, write: if false;
    }
    match /studyRoadmaps_backups/{runId}/applyStatus/{userId} {
      allow read, write: if false;
    }
    // ##ROADMAP:END##
    match /matchReports/{reportId} {
      allow read: if isActiveResourceOwner() || isAdmin();
      allow write: if false; // Protected. Modified only by Cloud Functions
    }
    // Academic CV Studio docs. The PUBLIC doc holds preview-safe fields
    // (preview Markdown, mode, status, credit cost). The FULL Markdown
    // lives in a /full/payload subdoc that's blocked from client reads
    // entirely — the only path to fullMarkdown is the unlock callable
    // which deducts credits atomically. Without this split, the
    // paywall would be trivially bypassable via the Firestore SDK
    // (a user could just fetch the doc and read fullMarkdown directly,
    // never paying).
    match /academicCvDocuments/{docId} {
      allow read: if isActiveResourceOwner() || isAdmin();
      allow write: if false;

      match /full/{full} {
        // Server-only. fullMarkdown lives here; client reads forbidden.
        allow read, write: if false;
      }
    }
    match /aiRuns/{aiRunId} {
      allow read: if isActiveResourceOwner() || isAdmin();
      allow write: if false; // Protected. Written only by Cloud Functions via Admin SDK
    }

    // ─────────────────────────────────────────────────────────────────────
    // F-1 Visa Interview Simulator (practice-only feature)
    // ─────────────────────────────────────────────────────────────────────
    // Sessions, messages, and reports are written exclusively by Cloud
    // Functions (Admin SDK). Users can read their own.
    match /visaInterviewSessions/{sessionId} {
      allow read: if isActiveResourceOwner() || isAdmin();
      allow write: if false;
    }
    match /visaInterviewMessages/{messageId} {
      allow read: if isActiveResourceOwner() || isAdmin();
      allow write: if false;
    }
    match /visaInterviewReports/{reportId} {
      allow read: if isActiveResourceOwner() || isAdmin();
      allow write: if false;
    }

    // Document upload metadata. Users CAN create entries themselves
    // because the actual upload goes straight to Storage from the client;
    // metadata fields are validated below to prevent tampering.
    //
    // SECURITY (P0 audit 2026-05-15): storagePath MUST live under the
    // caller's own users/{uid}/ prefix. Without this check, a malicious
    // client could create a doc pointing at another user's uploaded file
    // and have the recordVisaInterviewDocument Cloud Function (which uses
    // the Admin SDK, bypassing Storage rules) read & extract it back to
    // the attacker's session. The Cloud Function also re-validates this
    // path inside loadLatestDocument as belt-and-braces.
    match /visaInterviewDocuments/{documentId} {
      allow read: if isActiveResourceOwner() || isAdmin();
      allow create: if request.auth != null
        && isAccountActive(request.auth.uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.documentType in [
          'i20', 'ds160_confirmation',
          'bank_statement', 'employment_letter', 'sponsor_letter', 'transcript'
        ]
        && request.resource.data.status in ['uploaded', 'processing', 'ready', 'failed']
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('^users/' + request.auth.uid + '/visa-interviews/.*');
      // Only Cloud Functions update / delete (e.g. mark as processed)
      allow update, delete: if false;
    }

    // Waitlist — public can append their own email while we're soft-
    // launching. Nobody can read or modify entries from the client; the
    // founder reads them through the Firebase console.
    //
    // Audit 2026-05-15: tightened the regex so attackers can't sneak
    // newlines/semicolons/quotes into the email field for Resend
    // header-injection or noisy DB entries. Old regex `^[^@]+@[^@]+\.[^@]+$`
    // would match e.g. "foo\nBcc: victim@x.com@host.com" in CEL's regex
    // engine. The new pattern explicitly whitelists RFC-ish characters.
    // Waitlist signups now flow through the `submitWaitlist` Cloud Function
    // (validation + per-IP rate limit + per-email dedup). Direct client
    // writes are blocked — the function uses Admin SDK which bypasses
    // these rules anyway. Reads stay admin-only for the ops portal.
    match /waitlist/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Feedback survey responses — written exclusively by the
    // submitFeedbackSurvey Cloud Function (Admin SDK bypasses these
    // rules). Each row captures a user's post-match-report or
    // post-visa-interview rating + optional comment. Owner can read
    // their own row (for the "you've already given feedback" UI
    // signal); admin reads all for the ops portal Surveys page.
    match /surveyResponses/{responseId} {
      allow read: if isActiveResourceOwner() || isAdmin();
      allow write: if false;
    }

    // lifecycleEmailState — per-user server-managed bookkeeping for lifecycle
    // emails: the onboarding-nudge dedupe flag and the feedback-email cooldown
    // timestamp. Written exclusively by the sendEngagementReminders scheduler
    // and the feedback-request triggers via Admin SDK (which bypasses these
    // rules). Doc id is the user's uid. No client access — the user's own
    // opt-out lives on users/{uid}.emailPrefs, not here.
    match /lifecycleEmailState/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Pending referrals — server-managed ledger for the deferred referral
    // payout flow (referrer's 5 credits only post after the referee's
    // first paid purchase, defeats self-referral fraud). Doc id is the
    // referee's uid. Written exclusively by the applyReferralCode +
    // applyPaystackChargeSuccess Cloud Functions via Admin SDK, which
    // bypasses these rules. Direct client writes blocked; admin reads
    // only.
    match /pendingReferrals/{referredUserId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Bulk email campaigns — admin-driven mass sends. Top-level doc
    // carries the campaign metadata; per-recipient send state lives
    // in the `recipients` subcollection. Both written exclusively by
    // the sendBulkEmail Cloud Function via Admin SDK. Admin reads
    // only; clients never read or write.
    match /bulkCampaigns/{campaignId} {
      allow read: if isAdmin();
      allow write: if false;
      match /recipients/{recipientKey} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Paystack — one record per fulfilled purchase, written by the
    // paystackWebhook Cloud Function via Admin SDK (so the write side is
    // already protected). Users can read their own purchase history.
    // The old `dodoPayments` collection rule was removed 2026-05-24 when
    // we cut over to Paystack; historical Dodo data is orphaned and the
    // ops portal can ignore it.
    match /paystackPayments/{reference} {
      allow read: if isActiveResourceOwner() || isAdmin();
      allow write: if false;
    }

    // Ops error logs — structured records written by Cloud Functions when
    // an error occurs (Dodo webhook failures, HeyGen / Resend / Storage /
    // TTS failures, etc.). Read by the ops portal at ../UniFinder-ops to
    // surface errors for support analysts. Never written or read by the
    // user-facing app.
    match /errorLogs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;   // Written only by Cloud Functions via Admin SDK
    }

    // Ops audit log — append-only record of admin actions taken in the
    // ops portal (sign_in, user_viewed, future mutations like refunds
    // and credit grants). Same access shape as errorLogs: admin reads
    // for triage, no client writes — every entry is written by the
    // `recordOpsAuditEvent` Cloud Function which verifies the admin
    // custom claim before writing. This prevents a non-admin from
    // ever creating a forged audit entry, even if they got hold of
    // valid-shaped data.
    match /auditLogs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // User audit log — same shape as /auditLogs but for the main
    // user-facing app. Captures user_sign_in / user_sign_out events
    // from regular authenticated users so the ops portal can show
    // who signed in when. Kept in a SEPARATE collection from the
    // admin audit log because:
    //   - At scale, user events massively outnumber admin events;
    //     mixing them buries the security-relevant admin trail in
    //     a sea of routine sign-ins.
    //   - The two have different read profiles (admin: security
    //     audit / forensics; user: engagement analytics).
    // Reads admin-only; client writes blocked — entries flow only
    // through the `recordUserAuditEvent` Cloud Function.
    match /userAuditLogs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // App runtime config — single doc /appConfig/runtime holds the
    // maintenance-mode kill switch + custom maintenance message.
    // Public read because the user-facing app needs to detect
    // maintenance state without being authenticated; no client
    // writes — only the admin-gated `setMaintenanceMode` Cloud
    // Function can flip the flag.
    match /appConfig/{configId} {
      allow read:  if true;
      allow write: if false;
    }

    // Referral codes: small reverse-lookup docs from code → userId.
    // - Any logged-in user can read (needed to verify a code on signup).
    // - A user can only CREATE a code that maps to their own uid, and only
    //   if the code doc does not already exist (prevents claim hijacking).
    // - No updates or deletes from clients; only Cloud Functions touch these later.
    match /referralCodes/{code} {
      allow read: if request.auth != null
        && isAccountActive(request.auth.uid);
      allow create: if request.auth != null
        && isAccountActive(request.auth.uid)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
