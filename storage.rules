rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/visa-interviews/{sessionId}/{docType}/{fileName} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && docType in ["i20", "ds160_confirmation", "bank_statement",
                       "employment_letter", "sponsor_letter", "transcript"]
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType == "application/pdf" ||
          request.resource.contentType == "image/png" ||
          request.resource.contentType == "image/jpeg" ||
          request.resource.contentType == "image/jpg"
        );
      allow delete: if isOwner(uid);
    }
  }
}
